{
  "rules": {
    ".read": false,
    ".write": false,
    "agencies": {
      "$agencyId": {
        "users": {
          ".read": false,
          ".write": false
        },
        "verificationCodes": {
          ".read": false,
          ".write": false
        },
        "applications": {
